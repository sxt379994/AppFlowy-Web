# syntax=docker/dockerfile:1
#
# Repackage a locally validated Web build without rebuilding dependencies on the
# production VM. The pinned upstream image supplies the reviewed nginx runtime;
# only the static bundle and Tief runtime-config entrypoint are replaced.
FROM appflowyinc/appflowy_web:0.18.5@sha256:3a2e96b72f605e9028830ae0510f21c5cb21e159f7ac8582a723d713c94746fc

COPY dist/ /usr/share/nginx/html/
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/entrypoint.sh /docker-entrypoint.sh

RUN chmod 0755 /docker-entrypoint.sh
